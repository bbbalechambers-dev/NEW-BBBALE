{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bb-bale-chambers",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "NODE_ENV": "production",
    "ENABLE_CLOUDSQL": "false"
  }
}
