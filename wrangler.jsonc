{
 // wrangler.jsonc
"name": "new-bbbale",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "CHAMBERS_DB",
      "database_name": "bbbalechambers",
      "database_id": "eb94e59f-64ac-402e-95da-09747a0e51c7"
    },
    {
      "binding": "DB",
      "database_name": "bbbalechambers",
      "database_id": "eb94e59f-64ac-402e-95da-09747a0e51c7"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "ENABLE_CLOUDSQL": "false"
  }
}
