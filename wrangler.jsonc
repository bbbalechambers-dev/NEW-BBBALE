{
  "name": "new-bbbale",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
        "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "ENABLE_CLOUDSQL": "false"
  }
}
