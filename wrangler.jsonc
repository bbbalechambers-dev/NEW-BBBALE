{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bb-bale-chambers",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "CHAMBERS_DB",
      "database_name": "chambers-d1-db",
      "database_id": "chambers-d1-production"
    },
    {
      "binding": "DB",
      "database_name": "chambers-d1-db",
      "database_id": "chambers-d1-production"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "ENABLE_CLOUDSQL": "false"
  }
}
